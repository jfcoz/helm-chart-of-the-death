admissionController:
  container:
    resources:
      limits:
        memory: 150M
      requests:
        cpu: 100m
        memory: 150M
  networkPolicy:
    enabled: true
  podAnnotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict-local-volumes: sigstore
  replicas: 1
  revisionHistoryLimit: 3
  sigstoreVolume:
    emptyDir:
      medium: Memory
  tolerations:
    - effect: NoSchedule
      key: storage
      operator: Exists
backgroundController:
  resources:
    requests:
      cpu: 1m
  revisionHistoryLimit: 3
cleanupController:
  resources:
    requests:
      cpu: 1m
  revisionHistoryLimit: 3
config:
  webhooks:
    namespaceSelector:
      matchExpressions:
        - key: kubernetes.io/metadata.name
          operator: NotIn
          values:
            - kube-system
            - kube-node-lease
features:
  omitEvents:
    eventTypes:
      - PolicyApplied
reportsController:
  podAnnotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict-local-volumes: sigstore
  resources:
    limits:
      memory: 200Mi
    requests:
      cpu: 1m
      memory: 100Mi
  revisionHistoryLimit: 3
  sigstoreVolume:
    emptyDir:
      medium: Memory
test:
  sleep: 1
