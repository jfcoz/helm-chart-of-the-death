admissionController:
  replicas: 1
debug:
  - disallow-selinux
  - restrict-seccomp
  - restrict-sysctls
  - disallow-capabilities
  - disallow-host-namespaces
  - disallow-host-path
  - disallow-host-ports
  - disallow-privileged-containers
failurePolicy: Ignore
policyExclude:
  disallow-host-path:
    any:
      - resources:
          kinds:
            - Pod
          names:
            - falco-*
            - infra-falco-falco-*
          namespaces:
            - infra-falco
  disallow-privileged-containers:
    any:
      - resources:
          kinds:
            - Pod
          names:
            - falco-*
            - infra-falco-falco-*
          namespaces:
            - infra-falco
validationFailureAction: Enforce
