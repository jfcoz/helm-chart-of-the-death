admissionController:
  replicas: 1
failurePolicy: Ignore
policyExclude:
  disallow-host-path:
    any:
      - resources:
          kinds:
            - Pod
          names:
            - falco-*
            - infra-falco-falco-*
          namespaces:
            - infra-falco
  disallow-privileged-containers:
    any:
      - resources:
          kinds:
            - Pod
          names:
            - falco-*
            - infra-falco-falco-*
          namespaces:
            - infra-falco
policyType: ValidatingPolicy
validationFailureAction: Enforce
