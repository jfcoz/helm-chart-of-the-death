metricsServer:
  revisionHistoryLimit: 3
operator:
  revisionHistoryLimit: 3
prometheus:
  metricServer:
    enabled: true
    podMonitor:
      enabled: true
    serviceMonitor:
      enabled: true
  operator:
    enabled: true
    podMonitor:
      enabled: true
    prometheusRules:
      enabled: true
    serviceMonitor:
      enabled: true
  webhooks:
    enabled: true
    prometheusRules:
      enabled: true
    serviceMonitor:
      enabled: true
webhooks:
  revisionHistoryLimit: 3
