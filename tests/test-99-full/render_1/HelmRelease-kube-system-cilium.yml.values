apiRateLimit: endpoint-create=auto-adjust:true,mean-over:25,endpoint-delete=auto-adjust:true,mean-over:25
bpf:
  masquerade: true
cluster:
  name: change-me
dashboards:
  enabled: true
defaultLBServiceIPAM: none
gatewayAPI:
  enabled: true
ipam:
  operator:
    clusterPoolIPv4PodCIDRList:
      - 10.42.0.0/16
k8sServiceHost: fake.domain.name
k8sServicePort: 6443
kubeProxyReplacement: true
operator:
  dashboards:
    enabled: true
  rollOutPods: true
policyDenyResponse: icmp
prometheus:
  enabled: true
  metricsService: true
  serviceMonitor:
    enabled: true
rollOutCilliumPods: true
routingMode: tunnel
tunnelProtocol: geneve
