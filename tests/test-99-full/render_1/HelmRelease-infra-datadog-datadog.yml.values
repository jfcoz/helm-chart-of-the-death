agents:
  containers:
    agent:
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
    processAgent:
      resources:
        requests:
          cpu: 10m
          memory: 64Mi
    traceAgent:
      resources:
        requests:
          cpu: 30m
          memory: 100Mi
  priorityClassCreate: true
  priorityClassName: datadog
  revisionHistoryLimit: 3
  tolerations:
    - operator: Exists
  updateStrategy:
    rollingUpdate:
      maxUnavailable: 50%
clusterAgent:
  podAnnotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict-local-volumes: datadogrun,varlog,tmpdir,config
  revisionHistoryLimit: 3
  token: 4uftrVcbSdZL47LdGBvVNMO9G7xDoCAa
datadog:
  admissionController:
    configMode: service
  apiKey: 0123456789abcdef0123456789abcdef
  apm:
    instrumentation:
      skipKPITelemetry: true
    portEnabled: false
    socketEnabled: false
    useLocalService: true
  clusterName: change-me
  containerExcludeLogs: image:gke.gcr.io/event-exporter
  dogstatsd:
    useHostPort: false
    useSocketVolume: false
  env:
    - name: DD_LOGS_CONFIG_TAGGER_WARMUP_DURATION
      value: 60
    - name: DD_KUBERNETES_METADATA_TAG_UPDATE_FREQ
      value: 10
    - name: DD_TRACE_ENABLED
      value: 0
  kubelet:
    tlsVerify: true
  logLevel: ERROR
  logs:
    containerCollectAll: false
    enabled: false
  networkPolicy:
    create: true
  operator:
    enabled: false
  site: datadoghq.eu
discovery:
  enabled: false
