agents:
  containers:
    agent:
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
    processAgent:
      resources:
        requests:
          cpu: 10m
          memory: 64Mi
    traceAgent:
      resources:
        requests:
          cpu: 30m
          memory: 100Mi
  priorityClassCreate: true
  priorityClassName: datadog
  tolerations: []
  updateStrategy:
    rollingUpdate:
      maxUnavailable: 50%
datadog:
  apiKey: 0123456789abcdef0123456789abcdef
  clusterName: change-me
  containerExcludeLogs: image:gke.gcr.io/event-exporter
  env:
    - name: DD_LOGS_CONFIG_TAGGER_WARMUP_DURATION
      value: 60
    - name: DD_KUBERNETES_METADATA_TAG_UPDATE_FREQ
      value: 10
    - name: DD_TRACE_ENABLED
      value: 0
  kubelet:
    tlsVerify: true
  logLevel: ERROR
  logs:
    containerCollectAll: false
    enabled: false
  networkPolicy:
    create: true
  operator:
    enabled: false
  site: datadoghq.eu
