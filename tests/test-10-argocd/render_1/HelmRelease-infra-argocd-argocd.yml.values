applicationSet:
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 2m
      memory: 20M
configs:
  cm:
    dex.config: "connectors:\n- type: github\n  id: github\n  name: GitHub\n  config:\n    clientID: replace_by.github_client_id\n    clientSecret: replace_by.github_client_secret\n    orgs:\n    \n    - name: orgname\n      teams:\n      - team1\n      - team2\n"
    place_holder: never empty
controller:
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 5m
      memory: 40M
dex:
  logLevel: debug
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 2m
      memory: 100M
global:
  domain: argocd.replaced.by.kustomization
notifications:
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 2m
      memory: 40M
redis:
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 2m
      memory: 20M
repoServer:
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 5m
      memory: 40M
server:
  certificate:
    enabled: true
    issuer:
      group: cert-manager.io
      kind: ClusterIssuer
      name: self-signed
  httproute:
    enabled: true
    hostnames:
      - grafana.replaced.by.kustomization
    parentRefs:
      - group: gateway.networking.k8s.io
        kind: Gateway
        name: scaleway-gateway
        namespace: kube-system
        sectionName: https-prometheus
  ingress:
    annotations:
      nginx.ingress.kubernetes.io/backend-protocol: HTTPS
    enabled: true
    ingressClassName: nginx
    tls: true
  ingressGrpc:
    enabled: true
    ingressClassName: nginx
    tls: true
  metrics:
    enabled: false
  resources:
    requests:
      cpu: 2m
      memory: 50M
