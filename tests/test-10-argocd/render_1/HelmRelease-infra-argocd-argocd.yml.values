applicationSet:
  metrics:
    enabled: false
controller:
  metrics:
    enabled: false
dex:
  metrics:
    enabled: false
global:
  domain: argocd.replaced.by.kustomization
notifications:
  metrics:
    enabled: false
redis:
  metrics:
    enabled: false
repoServer:
  metrics:
    enabled: false
server:
  ingress:
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-production
    enabled: true
    ingressClassName: nginx
    tls: true
  metrics:
    enabled: false
